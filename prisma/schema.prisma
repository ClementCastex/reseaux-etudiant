generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Campus {
  id       String    @id @default(cuid())
  name     String    @unique
  students Student[]
  events   Event[]

  @@map("campuses")
}

model Student {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String
  campusId   String
  campus     Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  avatarUrl  String?
  bio        String?
  phone      String?
  formation  String?
  interests  String?   // JSON array stored as string
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  createdEvents   Event[]  @relation("EventCreator")
  participations  Event[]  @relation("EventParticipants")

  // Amis : studentId suit friendId
  friendsOf     Friendship[] @relation("FriendOf")
  friends       Friendship[] @relation("Friend")

  // Messagerie
  sentMessages     Message[]
  conversationParts ConversationParticipant[]

  @@index([campusId])
  @@index([email])
  @@map("students")
}

model Friendship {
  id         String   @id @default(cuid())
  studentId  String
  friendId   String
  createdAt  DateTime @default(now())

  student Student @relation("FriendOf", fields: [studentId], references: [id], onDelete: Cascade)
  friend  Student @relation("Friend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([studentId, friendId])
  @@index([studentId])
  @@map("friendships")
}

model Conversation {
  id        String    @id @default(cuid())
  isGroup   Boolean   @default(false)
  name      String?   // pour les groupes
  createdAt DateTime  @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  studentId      String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([conversationId, studentId])
  @@index([conversationId])
  @@index([studentId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Student     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Event {
  id           String    @id @default(cuid())
  title        String
  description  String
  imageUrl     String?
  startDate    DateTime
  endDate      DateTime
  campusId     String
  campus       Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  type         String     // soiree | sport | etude | culture | autre
  creatorId    String
  creator      Student   @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  participants Student[] @relation("EventParticipants")

  @@index([campusId])
  @@index([creatorId])
  @@index([startDate])
  @@map("events")
}
